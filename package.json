{
  "name": "cds-suite",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "firebase emulators:start --only hosting --project demo-cds-suite",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "build:shared": "node scripts/build-shared.mjs",
    "check:no-preview": "node scripts/check-no-preview.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cds-suite \"vitest run --config vitest.rules.config.mts\"",
    "test:emulator": "firebase emulators:exec --only auth,firestore,functions --project demo-cds-suite \"vitest run --config vitest.emulator.config.mts\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-cds-suite",
    "emulators:platform": "firebase emulators:start --only auth,firestore,functions --project demo-cds-suite",
    "seed:platform": "CDS_SEED_LOCAL=true FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 GCLOUD_PROJECT=demo-cds-suite node scripts/seed-platform-calendar-emulator.mjs",
    "dev:emulators": "node scripts/dev-platform.mjs --next-only",
    "dev:platform": "node scripts/dev-platform.mjs",
    "migrate:access:dry": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 GCLOUD_PROJECT=demo-cds-suite node scripts/migrate-access-v1.mjs --emulator",
    "preview": "firebase emulators:start --only hosting --project demo-cds-suite",
    "deploy:hosting": "firebase deploy --only hosting --project cds-administracion"
  },
  "dependencies": {
    "firebase": "12.18.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.577.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "firebase-tools": "^15.28.2",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
