# Configuración pública de la aplicación web: Firebase Console > Configuración del proyecto.
# Copiar a .env.local y completar. Nunca agregar service accounts o claves privadas.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Solo pruebas locales: habilitar con un project ID demo- y el emulador de Auth.
# Ignorado en builds de producción.
# NEXT_PUBLIC_USE_AUTH_EMULATOR=true
# Para pruebas completas Auth + Firestore, usar .env.development.local con proyecto demo-.
# Ver docs/local-auth-testing.md. Nunca habilitar contra un proyecto real.
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
